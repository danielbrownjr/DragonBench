CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_LWIP_MAX_SOCKETS=16
# DragonBench always creates both the AP and STA netifs; advertise on both.
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_MDNS_PREDEF_NETIF_AP=y
CONFIG_MDNS_PREDEF_NETIF_STA=y
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
# N8R8 (YD-ESP32-S3) and N16R8 boards: WS2812 status RGB LED data on GPIO48,
# no power GPIO. Board-owned: status light only, never fixture wiring.
CONFIG_DB_STATUS_RGB_GPIO=48
# Experiment profile: baseline unless an sdkconfig.defaults.<experiment>
# overlay selects exactly one other (docs/EXPERIMENT_PROFILES.md).
CONFIG_DB_EXPERIMENT_BASELINE=y
