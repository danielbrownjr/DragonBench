# Shared DragonBench defaults, every SoC target and board. ESP-IDF layers
# sdkconfig.defaults.<IDF_TARGET> (the SoC target's defaults) directly after
# this file, then the board overlay and any experiment overlay.
# ESP32-S3 is the default target and N8R8 its default board, so this file plus
# sdkconfig.defaults.esp32s3 is the N8R8 board profile.
CONFIG_IDF_TARGET="esp32s3"
# Every image's partition table ends below 8 MB; a board with more flash keeps
# the rest unused (docs/TARGET_N16R8.md, docs/TARGET_ESP32C5.md).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_LWIP_MAX_SOCKETS=16
# DragonBench always creates both the AP and STA netifs; advertise on both.
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_MDNS_PREDEF_NETIF_AP=y
CONFIG_MDNS_PREDEF_NETIF_STA=y
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
# Experiment profile: baseline unless an sdkconfig.defaults.<experiment>
# overlay selects exactly one other (docs/EXPERIMENT_PROFILES.md).
CONFIG_DB_EXPERIMENT_BASELINE=y
