# ESP32-S3 SoC target defaults. ESP-IDF layers this file after
# sdkconfig.defaults whenever the build target is esp32s3; ESP-IDF 5.3.5.
# Octal PSRAM at 80 MHz is the N8R8/N16R8 module configuration; TinyS3[D]
# overrides it with Quad PSRAM.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# N8R8 (YD-ESP32-S3) and N16R8 boards: WS2812 status RGB LED data on GPIO48,
# no power GPIO. Board-owned: status light only, never fixture wiring.
CONFIG_DB_STATUS_RGB_GPIO=48
